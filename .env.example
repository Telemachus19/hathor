# Local development only. Replace every value before using a shared environment.
AUTH_DB_ADMIN_PASSWORD=replace-with-auth-admin-password
AUTH_DB_PASSWORD=replace-with-auth-runtime-password
CATALOG_DB_ADMIN_PASSWORD=replace-with-catalog-admin-password
CATALOG_DB_PASSWORD=replace-with-catalog-runtime-password
COMMERCE_DB_ADMIN_PASSWORD=replace-with-commerce-admin-password
COMMERCE_DB_PASSWORD=replace-with-commerce-runtime-password
LIBRARY_DB_ADMIN_PASSWORD=replace-with-library-admin-password
LIBRARY_DB_PASSWORD=replace-with-library-runtime-password
RABBITMQ_USER=hathor_app
RABBITMQ_PASSWORD=replace-with-rabbitmq-password

# Administrative Secrets
INITIAL_ADMIN_BOOTSTRAP_SECRET=replace-with-bootstrap-secret-phrase

# Email Provider Configuration (log | smtp)
EMAIL_PROVIDER=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=noreply@hathor.example

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/user/oauth/google/callback
FRONTEND_URL=http://localhost:3000


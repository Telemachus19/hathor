{
  "name": "@hathor/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:api": "openapi-typescript openapi/public-api.openapi.yaml -o src/generated/openapi.ts && openapi-zod-client openapi/public-api.openapi.yaml -o src/generated/zod.ts --export-schemas && prettier --write src/generated/openapi.ts src/generated/zod.ts",
    "build": "npm run generate:api && tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "lint:openapi": "redocly lint --config redocly.yaml openapi/public-api.openapi.yaml openapi/internal-api.openapi.yaml",
    "lint:asyncapi": "node scripts/validate-asyncapi.mjs asyncapi/domain-events.asyncapi.yaml"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.0",
    "@redocly/cli": "2.39.0",
    "openapi-typescript": "^7.13.0",
    "openapi-zod-client": "^1.18.3",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@zodios/core": "^10.9.6",
    "openapi-fetch": "^0.17.0",
    "zod": "^3.23.8"
  }
}

{
  "info": {
    "_postman_id": "8a069df2-cd9c-4860-9519-c09a8eb543bf",
    "name": "Hathor Auth Service API",
    "description": "Collection to test the Hathor Auth Service endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            },
            "description": "Verifies if the API Gateway or sub-service container is running."
          },
          "response": []
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "Verifies if the database and external connections are ready."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Access & JWKS",
      "item": [
        {
          "name": "GET JWKS Public Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/.well-known/jwks.json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", ".well-known", "jwks.json"]
            },
            "description": "Exposes the active public keys in JWKS format used by downstream microservices to verify user JWTs."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication Flow",
      "item": [
        {
          "name": "Register Gamer (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Enforces Gamer role\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.roles).to.eql([\"gamer\"]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  // \"email\": \"gamer@hathor.com\", \"password\": \"Gamer123!\", \"displayName\": \"Demo Gamer\", \"captchaToken\": \"any-valid-mock-token\"\n  // \"email\": \"creator@hathor.com\", \"password\": \"Creator123!\", \"displayName\": \"Demo Creator\", \"captchaToken\": \"any-valid-mock-token\"\n  \"email\": \"admin@hathor.com\",\n  \"password\": \"Admin123!\",\n  \"displayName\": \"Demo Admin\",\n  \"captchaToken\": \"any-valid-mock-token\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "register"]
            },
            "description": "Registers a new user. The role defaults strictly to 'gamer' only."
          },
          "response": []
        },
        {
          "name": "Register Gamer (Captcha Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Returns validation failed error code\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.code).to.eql(\"VALIDATION_FAILED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gamer.test@example.com\",\n  \"password\": \"SuperSecurePassword123!\",\n  \"displayName\": \"Tester Gamer\",\n  \"captchaToken\": \"fail-token\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "register"]
            },
            "description": "Fails registration because it uses 'fail-token' which simulates a failed Turnstile verification check."
          },
          "response": []
        },
        {
          "name": "Login (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  // \"email\": \"gamer@hathor.com\", \"password\": \"Gamer123!\"\n  // \"email\": \"creator@hathor.com\", \"password\": \"Creator123!\"\n  \"email\": \"admin@hathor.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "login"]
            },
            "description": "Authenticates user credentials, sets the refresh token cookie, and saves the accessToken as an environment variable."
          },
          "response": []
        },
        {
          "name": "Login (Wrong Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gamer.test@example.com\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "login"]
            },
            "description": "Fails authentication due to an incorrect password."
          },
          "response": []
        },
        {
          "name": "Password Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gamer.test@example.com\",\n  \"newPassword\": \"BrandNewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/password/reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "password", "reset"]
            },
            "description": "Resets the user's password and increments their authorization_version, instantly invalidating any active access tokens."
          },
          "response": []
        },
        {
          "name": "Rotate Session (Refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "refresh"]
            },
            "description": "Sends the HttpOnly cookie, marks the old token as used, issues a new access token, and sets a rotated refresh token cookie."
          },
          "response": []
        },
        {
          "name": "Get Profile (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "me"]
            },
            "description": "Fetches the current user profile. It parses the Bearer JWT token from the Authorization header and performs signature and authorization version verification."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "logout"]
            },
            "description": "Revokes the active refresh token family, increments user's authorization version, and clears the cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "Disable Account (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/:userId/disable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", ":userId", "disable"],
              "variable": [
                {
                  "key": "userId",
                  "value": "user-id-to-disable"
                }
              ]
            },
            "description": "Disables a user account. This endpoint can only be called by an administrator, and immediately increments the target user's authorization_version, revoking all active sessions."
          },
          "response": []
        },
        {
          "name": "Enable Account (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/:userId/enable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", ":userId", "enable"],
              "variable": [
                {
                  "key": "userId",
                  "value": "user-id-to-enable"
                }
              ]
            },
            "description": "Enables a disabled user account. This endpoint can only be called by an administrator, and immediately increments the target user's authorization_version, updating all active sessions."
          },
          "response": []
        },
        {
          "name": "Change User Roles (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\"gamer\", \"creator\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/:userId/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", ":userId", "roles"],
              "variable": [
                {
                  "key": "userId",
                  "value": "user-id-to-modify-roles"
                }
              ]
            },
            "description": "Modifies the roles of a user. This endpoint can only be called by an administrator, executes in a transaction, writes to the role_change_audit trail, and immediately increments the target user's authorization_version."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Internal Services (Dev Only)",
      "item": [
        {
          "name": "Get Service Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Hathor-Service-Credential",
                "value": "commerce-service:commerce-service-secret-phrase",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  // SUCCESS: commerce-service is authorized to access catalog-service (scopes: catalog.quote.read, catalog.build.read)\n  \"audience\": \"catalog-service\"\n\n  // SUCCESS: commerce-service is authorized to access library-service (scopes: library.ownership.read)\n  // \"audience\": \"library-service\"\n\n  // FAILS (403 Forbidden): commerce-service is not authorized for commerce-service audience\n  // \"audience\": \"commerce-service\"\n\n  // FAILS (422 Unprocessable Entity): Unknown target service audience\n  // \"audience\": \"nonexistent-service\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/internal/v1/auth/service-tokens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "internal", "v1", "auth", "service-tokens"]
            },
            "description": "Requests a short-lived internal service JWT token. This endpoint is private and bypasses the gateway; we publish port 5001 directly to test it locally."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
}
